{
  "name": "dsh-learning-trace",
  "version": "0.1.1",
  "description": "把每次 DSH 任务的完整运作过程记录成可阅读的 Markdown：系统提示、请求头、每次模型调用与流式响应、工具调用、耗时与 TTFT。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "trace",
    "observability",
    "learning",
    "markdown"
  ],
  "author": "aXyer <wkleuven@sina.cn>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aXYer-SI/dsh-learning-trace.git"
  },
  "homepage": "https://github.com/aXYer-SI/dsh-learning-trace#readme",
  "bugs": {
    "url": "https://github.com/aXYer-SI/dsh-learning-trace/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/trace.test.mjs"
  }
}
