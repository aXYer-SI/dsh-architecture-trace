  "plugins": [
    {
      "name": "dsh-architecture-trace",
      "title": {
        "en": "DSH architecture trace",
        "zh": "DSH 架构追踪"
      },
      "description": {
        "en": "Records every DSH task run as Markdown: system prompt, request headers, each model call with its streamed response, tool calls and results, timings and time to first token. Read how DSH's architecture wires prompts, models and tools into one turn; the same file benchmarks TTFT, tok/s and context size across models.",
        "zh": "把每次 DSH 任务的完整运作过程记录成 Markdown：系统提示、请求头、每次模型调用与流式响应、工具调用与结果、耗时与首字时间。用一份可读的文档，看清 DSH 架构如何把提示、模型与工具串成一轮；同一份文件也能横向比较模型的 TTFT、tok/s 与上下文规模。"
      },
